# Token de GitHub para auto
# Crear en: https://github.com/settings/tokens
# Permisos necesarios: repo (todos los scopes de repo)
GITHUB_TOKEN=tu_github_token_aqui
GH_TOKEN=tu_github_token_aqui

# Para publicar en npm no hace falta ninguna variable aquí: `npm publish` usa la sesión de
# `npm login` (o el token de ~/.npmrc).
