# Verificaciones antes de cada commit. Solo corren si hay archivos TypeScript en staging.
#   1. ESLint sobre esos archivos (sin warnings).
#   2. TypeScript sobre todo el proyecto (los tests también se compilan en `npm run build`).
#   3. Los tests relacionados con esos archivos (no toda la suite; el CI ejecuta la suite completa).
#
# Se comprueba el árbol de trabajo, no solo lo que está en staging. Para saltarlo en un caso
# puntual: `git commit --no-verify` (o `HUSKY=0 git commit ...`).

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'src/*.tsx')

if [ -z "$STAGED" ]; then
  exit 0
fi

echo "pre-commit: ESLint"
echo "$STAGED" | xargs npx --no -- eslint --max-warnings 0 --report-unused-disable-directives

echo "pre-commit: TypeScript"
npx --no -- tsc --noEmit

echo "pre-commit: tests relacionados"
echo "$STAGED" | xargs npx --no -- vitest related --run --passWithNoTests
